# Jellyfin Media Optimizer - Environment Configuration Template
# Copy this file to .env and adjust the settings as needed.

# ==========================================
# Application & Server Configuration
# ==========================================
PORT=8097
INTERNAL_PORT=8080
HOST=0.0.0.0
APP_ENV=production
DEBUG=false
SECRET_KEY=change_this_to_a_random_secure_secret_key_at_least_32_characters_long

# Linux Server User & Group IDs (matches linuxserver standard)
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# ==========================================
# Jellyfin Connection
# ==========================================
# Inside Docker network 'apps', Jellyfin is reached via http://jellyfin:8096
JELLYFIN_URL=http://jellyfin:8096
# Generate an API key in Jellyfin Dashboard -> Advanced -> API Keys
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# ==========================================
# Storage & Paths (Host Paths mapped in Docker)
# ==========================================
CONFIG_DIR=/data/media/config/media-optimizer
DATA_DIR=/data/media/config/media-optimizer/db
WORK_DIR=/data/media/optimizer-work
BACKUP_DIR=/data/media/optimizer-backups

# Media Mounts
MOVIES_DIR=/data/media/movies
TV_DIR=/data/media/tv
ANIME_DIR=/data/media/anime

# Storage Thresholds (Safety pre-flight checks)
# Minimum free space required on /work and destination in Gigabytes
MIN_FREE_SPACE_GB=15
# Maximum temporary disk space in Gigabytes before refusing new jobs
MAX_TEMP_STORAGE_GB=100

# ==========================================
# Worker & Queue Settings
# ==========================================
# Maximum simultaneous video encoding jobs (1 is strongly recommended for home servers)
MAX_CONCURRENT_ENCODES=1
# CPU thread limit per FFmpeg encode (0 = auto / all available)
FFMPEG_THREADS=0
# Default replacement mode: 'replace_with_backup', 'optimized_copy', or 'manual_approval'
DEFAULT_REPLACEMENT_MODE=replace_with_backup
# Backup retention in days (0 = keep indefinitely)
BACKUP_RETENTION_DAYS=14

# ==========================================
# Hardware Acceleration
# ==========================================
# Options: 'auto', 'vaapi', 'qsv', 'nvenc', 'cpu'
HWACCEL_MODE=auto
# Render device for VAAPI/QuickSync
DRI_DEVICE=/dev/dri/renderD128
# Allow automatic fallback to CPU if hardware encoder fails
HWACCEL_FALLBACK_CPU=true

# ==========================================
# Notifications (Optional)
# ==========================================
# ntfy.sh or self-hosted ntfy instance
NTFY_ENABLED=false
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Telegram Bot
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP Email
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
